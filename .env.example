# Node backend only. Set an absolute path to the private server JSON file.
# In production this file must be outside the application and public_html.
# SMTP credentials belong in the JSON, never in NEXT_PUBLIC_* or VITE_* variables.
MAGIC_KLICK_EMAIL_CONFIG=
# Optional directory outside the application and public document root.
# Leave empty for ../orders; relative paths use the application's working directory.
MAGIC_KLICK_ORDERS_DIRECTORY=
